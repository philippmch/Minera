inline void require(bool yes,const std::string& why){if(!yes)throw std::runtime_error(why);}
inline void exact(const std::string& actual,const std::string& expected,const std::string& context){
 if(actual==expected)return;std::size_t at=0;while(at<actual.size()&&at<expected.size()&&actual[at]==expected[at])++at;
 throw std::runtime_error(context+" differs at byte "+std::to_string(at)+" actual="+std::to_string(actual.size())+" expected="+std::to_string(expected.size()));
}
using Fields=std::vector<std::pair<std::string,std::string>>;
class Reader {
 std::string_view s_;std::size_t at_=0;
 void space(){while(at_<s_.size()&&(s_[at_]==' '||s_[at_]=='\t'||s_[at_]=='\r'||s_[at_]=='\n'))++at_;}
 bool take(char c){space();if(at_<s_.size()&&s_[at_]==c){++at_;return true;}return false;}
 void expect(char c){require(take(c),"invalid response JSON delimiter");}
 std::string string(){space();const auto begin=at_;require(at_<s_.size()&&s_[at_++]=='"',"response string required");bool closed=false;
  while(at_<s_.size()){const unsigned char c=s_[at_++];require(c>=32,"response string control byte");if(c=='"'){closed=true;break;}if(c=='\\'){require(at_<s_.size(),"response truncated escape");++at_;}}
  require(closed,"response unterminated string");return minera::parse_literal_string_vector_json("["+std::string(s_.substr(begin,at_-begin))+"]").at(0);}
 void number(){space();const auto begin=at_;if(at_<s_.size()&&s_[at_]=='-')++at_;require(at_<s_.size(),"response truncated number");
  if(s_[at_]=='0')++at_;else{require(s_[at_]>='1'&&s_[at_]<='9',"response invalid number");while(at_<s_.size()&&s_[at_]>='0'&&s_[at_]<='9')++at_;}
  if(at_<s_.size()&&s_[at_]=='.'){++at_;const auto d=at_;while(at_<s_.size()&&s_[at_]>='0'&&s_[at_]<='9')++at_;require(at_>d,"response invalid fraction");}
  if(at_<s_.size()&&(s_[at_]=='e'||s_[at_]=='E')){++at_;if(at_<s_.size()&&(s_[at_]=='+'||s_[at_]=='-'))++at_;const auto d=at_;while(at_<s_.size()&&s_[at_]>='0'&&s_[at_]<='9')++at_;require(at_>d,"response invalid exponent");}require(at_>begin,"response invalid number");}
 void value(std::size_t depth){require(depth<96,"response excessive JSON nesting");space();require(at_<s_.size(),"response missing JSON value");
  if(s_[at_]=='{'){(void)object(depth+1);return;}if(s_[at_]=='['){++at_;if(take(']'))return;do{value(depth+1);}while(take(','));expect(']');return;}
  if(s_[at_]=='"'){(void)string();return;}for(const std::string_view w:{"true","false","null"})if(s_.substr(at_,w.size())==w){at_+=w.size();return;}number();}
 Fields object(std::size_t depth){expect('{');Fields f;if(take('}'))return f;do{auto k=string();for(const auto& old:f)require(old.first!=k,"response duplicate JSON key");expect(':');space();const auto begin=at_;value(depth);f.emplace_back(k,std::string(s_.substr(begin,at_-begin)));}while(take(','));expect('}');return f;}
 public:explicit Reader(std::string_view s):s_(s){}Fields fields(){auto f=object(0);space();require(at_==s_.size(),"response trailing JSON");return f;}
};
inline const std::string& raw(const Fields& f,const std::string& k){for(const auto& p:f)if(p.first==k)return p.second;throw std::runtime_error("response missing "+k);}
inline std::optional<std::string> string(const Fields& f,const std::string& k){const auto& v=raw(f,k);if(v=="null")return std::nullopt;
 if(!v.empty()&&v[0]=='"')return minera::parse_literal_string_vector_json("["+v+"]").at(0);
 const auto n=Reader(v).fields();require(n.size()==2&&raw(n,"native_bytes")=="\"hex-v1\"","invalid native string encoding");
 const auto hex=minera::parse_literal_string_vector_json("["+raw(n,"data")+"]").at(0);require(hex.size()%2==0,"odd native string hex");
 const auto digit=[](char c){require((c>='0'&&c<='9')||(c>='a'&&c<='f'),"invalid native string hex");return c<='9'?c-'0':c-'a'+10;};
 std::string result;for(std::size_t i=0;i<hex.size();i+=2)result.push_back(static_cast<char>(digit(hex[i])*16+digit(hex[i+1])));return result;}
inline void text_is(const Fields& f,const std::string& k,const std::string& v,const std::string& c){const auto got=string(f,k);require(got.has_value(),c+" missing "+k);exact(*got,v,c+" "+k);}
inline void optional_is(const Fields& f,const std::string& k,const std::optional<std::string>& v,const std::string& c){if(v)text_is(f,k,*v,c);else require(raw(f,k)=="null",c+" fabricated "+k);}
inline std::string q(const std::string& s){return serialize_embedding_workbench_string_json(s);}
inline std::string cell_artifact(const EventAttribute& value){EventTable table;table.columns={"value"};table.dtypes={"object"};table.rows={{value}};return serialize_embedding_workbench_table_json(table);}
inline std::string value_operand(const EventAttribute& value){return "{\"kind\":\"value\",\"value_json\":"+q(cell_artifact(value))+'}';}
inline std::string admission_operand(const LogVariantsAdmissionDictionary& native,const std::vector<std::pair<EventAttribute,EventAttribute>>& entries){
 require(native.keys.size()==entries.size(),"expected admission prefix size");std::string out="{\"kind\":\"admission_dictionary\",\"entries\":[";bool first=true;
 for(std::size_t i=0;i<entries.size();++i){exact(cell_artifact(native.keys[i]),cell_artifact(entries[i].first),"original admission key constructor");if(!first)out+=',';first=false;out+="{\"key_json\":"+q(cell_artifact(entries[i].first))+",\"value_json\":"+q(cell_artifact(entries[i].second))+'}';}return out+"]}";
}
inline std::string variants_operand(const LogVariantsDictionary& entries){
 std::string out="{\"kind\":\"variants_dictionary\",\"entries\":[";bool first=true;
 for(const auto& x:entries){if(!first)out+=',';first=false;EventLog log;log.traces=x.traces;out+="{\"key_json\":"+q(cell_artifact(x.variant))+",\"traces_json\":"+q(serialize_embedding_workbench_raw_log_json(log))+",\"ordinary_value_json\":"+(x.ordinary_value?q(cell_artifact(*x.ordinary_value)):"null")+'}';}return out+"]}";
}
struct ParameterEntry {EventAttribute key,value;bool enum_key=false;std::optional<std::string> enum_module,enum_name;};
inline std::string parameter_operand(const std::vector<ParameterEntry>& entries){
 std::string out="{\"kind\":\"parameter_dictionary\",\"entries\":[";bool first=true;
 for(const auto& x:entries){if(!first)out+=',';first=false;out+="{\"key_json\":"+q(cell_artifact(x.key))+",\"value_json\":"+q(cell_artifact(x.value))+",\"enum_key\":"+(x.enum_key?"true":"false")+",\"enum_module\":"+(x.enum_module?q(*x.enum_module):"null")+",\"enum_name\":"+(x.enum_name?q(*x.enum_name):"null")+'}';}return out+"]}";
}
inline std::string controls(const std::vector<std::string>& args,const std::vector<std::pair<std::string,std::string>>& keywords,
 const std::string& state,const std::optional<std::string>& parameters,const LogVariantsFilterOptions* options,const std::optional<EventAttribute>& bound){
 std::string out="{\"args\":[";bool first=true;for(const auto& x:args){if(!first)out+=',';first=false;out+=x;}
 out+="],\"keyword_entries\":[";first=true;for(const auto& x:keywords){if(!first)out+=',';first=false;out+="{\"key\":"+q(x.first)+",\"value\":"+x.second+'}';}
 out+="],\"parameter_state\":"+q(state)+",\"parameters\":"+(parameters?*parameters:"null")+",\"resolved\":{\"options_present\":"+(options?"true":"false")
  +",\"activity_key_json\":"+(options?q(cell_artifact(options->activity_key)):"null")+",\"positive_json\":"+(options?q(cell_artifact(options->positive)):"null")
  +",\"raw_parameters_json\":"+(options&&options->raw_parameters?q(cell_artifact(*options->raw_parameters)):"null")+",\"bound_json\":"+(bound?q(cell_artifact(*bound)):"null")+"}}";return out;
}
inline std::string double_artifact(double value){EventTable table;table.columns={"value"};table.dtypes={"float64"};table.rows={{float_value("",value)}};return serialize_embedding_workbench_table_json(table);}
inline void count_is(const Fields& f,const std::string& k,const EventLog& log,const std::string& c){const auto n=Reader(raw(f,k)).fields();std::size_t events=0;for(const auto& t:log.traces)events+=t.events.size();require(n.size()==2&&raw(n,"traces")==std::to_string(log.traces.size())&&raw(n,"events")==std::to_string(events),c+" counts "+k);}
using Sender=std::function<DiscoveryWorkbenchResponse(const std::vector<DiscoveryWorkbenchPart>&)>;
inline void check(const Sender& send,const std::string& context,const std::string& operation,const std::string& call,
 const EventLog& source,const EventLog& source_after,const std::optional<EventLog>& result,const std::optional<double>& value,
 const std::string& expected_controls_before,const std::string& expected_controls_after,const std::string& error_type,const std::string& error){
 require(!(result&&value),context+" impossible two result arms");const bool success=result.has_value()||value.has_value();
 const auto before=serialize_embedding_workbench_raw_log_json(source),after=serialize_embedding_workbench_raw_log_json(source_after);
 exact(serialize_embedding_workbench_raw_log_json(parse_embedding_workbench_raw_log_json(before)),before,context+" original source exact import");
 std::vector<DiscoveryWorkbenchPart> parts={{"operation","",operation,false},{"source_file","misleading.csv",before,true},{"call_json","",call,false}};
 const auto original=parts;const auto answer=send(parts);require(parts.size()==original.size(),context+" request part count changed");
 for(std::size_t i=0;i<parts.size();++i)require(parts[i].name==original[i].name&&parts[i].filename==original[i].filename&&parts[i].file==original[i].file&&parts[i].bytes==original[i].bytes,context+" request/source/control bytes changed");
 exact(serialize_embedding_workbench_raw_log_json(source),before,context+" caller original source changed");
 const auto fields=Reader(answer.json).fields();const std::vector<std::string> keys={"family","operation","http_status","phase","source_format","source","result","source_unchanged","call_mode","call_json","controls_before_json","controls_after_json","controls_unchanged","source_log_json","source_after_log_json","filtered_log_json","filtered_xes","xes_error","value_json","error_type","error"};
 require(fields.size()==21,context+" fixed21 response keys");for(const auto& key:keys)(void)raw(fields,key);
 require(answer.status==(success?200:400)&&raw(fields,"http_status")==std::to_string(answer.status),context+" HTTP status mismatch");
 text_is(fields,"family","REFERENCE_LOG_VARIANTS",context);text_is(fields,"operation",operation,context);text_is(fields,"call_mode","original",context);text_is(fields,"call_json",call,context);
 text_is(fields,"phase",success?"complete":"filter",context);text_is(fields,"source_format","native_log",context);
 text_is(fields,"source_log_json",before,context);text_is(fields,"source_after_log_json",after,context);count_is(fields,"source",source,context);
 require(raw(fields,"source_unchanged")== (before==after?"true":"false"),context+" source mutation flag");
 exact(serialize_embedding_workbench_raw_log_json(parse_embedding_workbench_raw_log_json(*string(fields,"source_after_log_json"))),after,context+" full source-after reopen");
 text_is(fields,"controls_before_json",expected_controls_before,context);text_is(fields,"controls_after_json",expected_controls_after,context);
 require(raw(fields,"controls_unchanged")== (expected_controls_before==expected_controls_after?"true":"false"),context+" full actual controls mutation flag");
 if(!success){for(const std::string key:{"result","filtered_log_json","filtered_xes","xes_error","value_json"})require(raw(fields,key)=="null",context+" error fabricated "+key);text_is(fields,"error_type",error_type,context);text_is(fields,"error",error,context);return;}
 require(raw(fields,"error_type")=="null"&&raw(fields,"error")=="null",context+" unexpected full diagnostic");
 if(value){for(const std::string key:{"result","filtered_log_json","filtered_xes","xes_error"})require(raw(fields,key)=="null",context+" helper fabricated log "+key);
  const auto expected=double_artifact(*value);text_is(fields,"value_json",expected,context);exact(serialize_embedding_workbench_table_json(parse_embedding_workbench_table_json(*string(fields,"value_json"))),expected,context+" native double artifact reopen");return;}
 require(raw(fields,"value_json")=="null",context+" log fabricated scalar");count_is(fields,"result",*result,context);const auto expected=serialize_embedding_workbench_raw_log_json(*result);
 text_is(fields,"filtered_log_json",expected,context);exact(serialize_embedding_workbench_raw_log_json(parse_embedding_workbench_raw_log_json(*string(fields,"filtered_log_json"))),expected,context+" full result reopen");
 std::string xes,xes_error;try{XesExportOptions opts;opts.preserve_nulls=true;xes=serialize_xes(*result,opts);}catch(const std::exception& e){xes_error=e.what();}
 if(xes_error.empty()){text_is(fields,"filtered_xes",xes,context);require(raw(fields,"xes_error")=="null",context+" unexpected XES error");}
 else{require(raw(fields,"filtered_xes")=="null",context+" failed XES artifact");text_is(fields,"xes_error",xes_error,context);}
}
