<pnml><net id="fresh" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel"><page id="page">
<place id="p0"><name><text>p0</text></name><initialMarking><text>1</text></initialMarking></place>
<place id="p1"><name><text>p1</text></name></place>
<place id="p2"><name><text>p2</text></name></place>
<place id="p3"><name><text>p3</text></name></place>
<transition id="t0"><name><text>ReceiveDraft</text></name></transition>
<transition id="t1"><name><text>silent</text></name><toolspecific tool="ProM" version="6.4" activity="$invisible$"/></transition>
<transition id="t2"><name><text>SealDraft</text></name></transition>
<arc id="a0" source="p0" target="t0"><inscription><text>1</text></inscription></arc>
<arc id="a1" source="p1" target="t1"><inscription><text>1</text></inscription></arc>
<arc id="a2" source="p2" target="t2"><inscription><text>1</text></inscription></arc>
<arc id="a3" source="t0" target="p1"><inscription><text>1</text></inscription></arc>
<arc id="a4" source="t1" target="p2"><inscription><text>1</text></inscription></arc>
<arc id="a5" source="t2" target="p3"><inscription><text>1</text></inscription></arc>
</page><finalmarkings><marking>
<place idref="p3"><text>1</text></place>
</marking></finalmarkings></net></pnml>