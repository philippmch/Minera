  if(s_[at_]=='{'){(void)object(depth+1);return;}if(s_[at_]=='['){++at_;if(take(']'))return;do{value(depth+1);}while(take(','));expect(']');return;}
  if(s_[at_]=='"'){(void)string();return;}for(std::string_view w:{"true","false","null"})if(s_.substr(at_,w.size())==w){at_+=w.size();return;}number();}
 Fields object(std::size_t depth){expect('{');Fields f;if(take('}'))return f;do{auto k=string();for(const auto& old:f)require(old.first!=k,"response duplicate key");expect(':');space();const auto begin=at_;value(depth);f.emplace_back(k,std::string(s_.substr(begin,at_-begin)));}while(take(','));expect('}');return f;}
 public:explicit Reader(std::string_view s):s_(s){}Fields fields(){auto f=object(0);space();require(at_==s_.size(),"response trailing JSON");return f;}
};
inline const std::string& raw(const Fields& f,const std::string& k){for(const auto& p:f)if(p.first==k)return p.second;throw std::runtime_error("response missing "+k);}
inline std::optional<std::string> string(const Fields& f,const std::string& k){const auto& v=raw(f,k);if(v=="null")return std::nullopt;
 if(!v.empty()&&v[0]=='"')return parse_literal_string_vector_json("["+v+"]").at(0);
 const auto n=Reader(v).fields();require(n.size()==2&&raw(n,"native_bytes")=="\"hex-v1\"","invalid native string carrier");
 const auto hex=parse_literal_string_vector_json("["+raw(n,"data")+"]").at(0);require(hex.size()%2==0,"odd native string hex");
 const auto digit=[](char c){require((c>='0'&&c<='9')||(c>='a'&&c<='f'),"invalid native string hex");return c<='9'?c-'0':c-'a'+10;};std::string result;
 for(std::size_t i=0;i<hex.size();i+=2)result.push_back(static_cast<char>(digit(hex[i])*16+digit(hex[i+1])));return result;
}
inline void text_is(const Fields& f,const std::string& key,const std::string& expected,const std::string& context){const auto got=string(f,key);require(got.has_value(),context+" missing "+key);exact(*got,expected,context+" "+key);}
