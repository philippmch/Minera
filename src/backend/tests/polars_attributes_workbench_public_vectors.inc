 if(x.parameters)for(std::size_t i=0;i<x.parameters->size();++i)floating_bits(x.parameters->at(i).value,y.parameters->at(i).value,context);
 if(x.count_cache){if(const auto* v=std::get_if<EventAttribute>(&*x.count_cache))floating_bits(*v,std::get<EventAttribute>(*y.count_cache),context);else for(std::size_t i=0;i<std::get<PolarsAttributeCounts>(*x.count_cache).size();++i){const auto& p=std::get<PolarsAttributeCounts>(*x.count_cache)[i];const auto& q=std::get<PolarsAttributeCounts>(*y.count_cache)[i];floating_bits(p.value,q.value,context);floating_bits(p.count,q.count,context);}}
