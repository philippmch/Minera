 const auto& n=expected.native;const auto& o=n.options;
 std::string result="{\"input_kind\":"+q(expected.eager?"DataFrame":"LazyFrame")+",\"operation\":"+std::to_string(static_cast<int>(n.operation))+",\"keyword_order\":[";
 bool first=true;for(const auto& key:expected.keyword_order){if(!first)result+=',';first=false;result+=q(key);}result+="],\"arguments\":{";
 first=true;for(const auto& pair:std::vector<std::pair<std::string,std::optional<EventAttribute>>>{{"values",n.values},{"lower",n.lower},{"upper",n.upper},{"threshold",n.threshold},{"maximum",n.maximum},{"stake",n.stake},{"attribute",n.attribute},{"most_common_variant",n.most_common_variant}}){if(!first)result+=',';first=false;result+=q(pair.first)+':'+optional_cell(pair.second);}result+="},\"options\":{";
