 const auto state=n.parameters?"entries":n.parameter_value?"raw":"omitted";result+=",\"parameter_state\":"+q(state)+",\"parameters_json\":";
 if(n.parameters){EventTable p;p.columns={"key","value","enum_key"};p.dtypes={"object","object","object"};for(const auto& e:*n.parameters)p.rows.push_back({EventAttribute{"",e.key},e.value,EventAttribute{"",e.enum_key?"true":"false",AttributeKind::kBoolean}});result+=q(serialize_embedding_workbench_table_json(p));}
 else result+=n.parameter_value?q(cell(*n.parameter_value)):"null";
 result+=",\"count_cache\":{\"state\":";std::string state_cache="omitted",value_cache="null",entries="[";
 if(n.count_cache){if(const auto* value=std::get_if<EventAttribute>(&*n.count_cache)){state_cache="value";value_cache=q(cell(*value));}else{state_cache="entries";bool pair_first=true;for(const auto& e:std::get<PolarsAttributeCounts>(*n.count_cache)){if(!pair_first)entries+=',';pair_first=false;entries+="{\"key_json\":"+q(cell(e.value))+",\"value_json\":"+q(cell(e.count))+'}';}}}
 return result+q(state_cache)+",\"value_json\":"+value_cache+",\"entries\":"+entries+"]}}";
}
inline void floating_bits(const EventAttribute& a,const EventAttribute& b,const std::string& context){
 if(const auto* x=std::get_if<double>(&a.typed_value)){const auto* y=std::get_if<double>(&b.typed_value);require(y&&std::bit_cast<std::uint64_t>(*x)==std::bit_cast<std::uint64_t>(*y),context+" control float bits");}
 require(a.children.size()==b.children.size(),context+" control children count");for(std::size_t i=0;i<a.children.size();++i)floating_bits(a.children[i],b.children[i],context);
}
