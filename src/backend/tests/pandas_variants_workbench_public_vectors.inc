namespace retained_pandas_variants_transport {
inline void require(bool yes,const std::string& why){if(!yes)throw std::runtime_error(why);}
inline void exact(const std::string& actual,const std::string& expected,const std::string& context){
 if(actual==expected)return;std::size_t at=0;while(at<actual.size()&&at<expected.size()&&actual[at]==expected[at])++at;
 throw std::runtime_error(context+" differs at byte "+std::to_string(at)+" actual="+std::to_string(actual.size())+" expected="+std::to_string(expected.size()));
}
using Fields=std::vector<std::pair<std::string,std::string>>;
class Reader {
 std::string_view s_;std::size_t at_=0;
 void space(){while(at_<s_.size()&&(s_[at_]==' '||s_[at_]=='\t'||s_[at_]=='\r'||s_[at_]=='\n'))++at_;}
 bool take(char c){space();if(at_<s_.size()&&s_[at_]==c){++at_;return true;}return false;}
 void expect(char c){require(take(c),"invalid response JSON delimiter");}
 std::string string(){space();const auto begin=at_;require(at_<s_.size()&&s_[at_++]=='"',"response string required");bool closed=false;
  while(at_<s_.size()){const unsigned char c=s_[at_++];require(c>=32,"response string control byte");if(c=='"'){closed=true;break;}if(c=='\\'){require(at_<s_.size(),"response truncated escape");++at_;}}
  require(closed,"response unterminated string");return minera::parse_literal_string_vector_json("["+std::string(s_.substr(begin,at_-begin))+"]").at(0);}
 void number(){space();const auto begin=at_;if(at_<s_.size()&&s_[at_]=='-')++at_;require(at_<s_.size(),"response truncated number");
  if(s_[at_]=='0')++at_;else{require(s_[at_]>='1'&&s_[at_]<='9',"response invalid number");while(at_<s_.size()&&s_[at_]>='0'&&s_[at_]<='9')++at_;}
  if(at_<s_.size()&&s_[at_]=='.'){++at_;const auto d=at_;while(at_<s_.size()&&s_[at_]>='0'&&s_[at_]<='9')++at_;require(at_>d,"response invalid fraction");}
  if(at_<s_.size()&&(s_[at_]=='e'||s_[at_]=='E')){++at_;if(at_<s_.size()&&(s_[at_]=='+'||s_[at_]=='-'))++at_;const auto d=at_;while(at_<s_.size()&&s_[at_]>='0'&&s_[at_]<='9')++at_;require(at_>d,"response invalid exponent");}require(at_>begin,"response invalid number");}
 void value(std::size_t depth){require(depth<96,"response excessive JSON nesting");space();require(at_<s_.size(),"response missing JSON value");
  if(s_[at_]=='{'){(void)object(depth+1);return;}if(s_[at_]=='['){++at_;if(take(']'))return;do{value(depth+1);}while(take(','));expect(']');return;}
  if(s_[at_]=='"'){(void)string();return;}for(const std::string_view w:{"true","false","null"})if(s_.substr(at_,w.size())==w){at_+=w.size();return;}number();}
 Fields object(std::size_t depth){expect('{');Fields f;if(take('}'))return f;do{auto k=string();for(const auto& old:f)require(old.first!=k,"response duplicate JSON key");expect(':');space();const auto begin=at_;value(depth);f.emplace_back(k,std::string(s_.substr(begin,at_-begin)));}while(take(','));expect('}');return f;}
 public:explicit Reader(std::string_view s):s_(s){}Fields fields(){auto f=object(0);space();require(at_==s_.size(),"response trailing JSON");return f;}
};
inline const std::string& raw(const Fields& f,const std::string& k){for(const auto& p:f)if(p.first==k)return p.second;throw std::runtime_error("response missing "+k);}
inline std::optional<std::string> string(const Fields& f,const std::string& k){const auto& v=raw(f,k);if(v=="null")return std::nullopt;
 if(!v.empty()&&v[0]=='"')return minera::parse_literal_string_vector_json("["+v+"]").at(0);
 const auto n=Reader(v).fields();require(n.size()==2&&raw(n,"native_bytes")=="\"hex-v1\"","invalid native string encoding");
 const auto hex=minera::parse_literal_string_vector_json("["+raw(n,"data")+"]").at(0);require(hex.size()%2==0,"odd native string hex");
 const auto digit=[](char c){require((c>='0'&&c<='9')||(c>='a'&&c<='f'),"invalid native string hex");return c<='9'?c-'0':c-'a'+10;};
 std::string result;for(std::size_t i=0;i<hex.size();i+=2)result.push_back(static_cast<char>(digit(hex[i])*16+digit(hex[i+1])));return result;}
inline void text_is(const Fields& f,const std::string& k,const std::string& v,const std::string& c){const auto got=string(f,k);require(got.has_value(),c+" missing "+k);exact(*got,v,c+" "+k);}
inline void optional_is(const Fields& f,const std::string& k,const std::optional<std::string>& v,const std::string& c){if(v)text_is(f,k,*v,c);else require(raw(f,k)=="null",c+" fabricated "+k);}
inline std::string q(const std::string& s){return serialize_embedding_workbench_string_json(s);}
inline std::string cell_artifact(const EventAttribute& value){EventTable table;table.columns={"value"};table.dtypes={"object"};table.rows={{value}};return serialize_embedding_workbench_table_json(table);}
inline std::string operand(const EventAttribute& value){return "{\"kind\":\"value\",\"value_json\":"+q(cell_artifact(value))+'}';}
inline std::string operand(const PandasVariantsAdmittedMapping& value){
 std::string out="{\"kind\":\"admission_dictionary\",\"entries\":[";bool first=true;
 for(const auto& pair:value.entries){if(!first)out+=',';first=false;out+="{\"key_json\":"+q(cell_artifact(pair.first))+",\"value_json\":"+q(cell_artifact(pair.second))+'}';}
 return out+"]}";
}
inline std::string parameter(const EventAttribute& value){return operand(value);}
inline std::string parameter(const std::vector<PandasVariantsFilterParameter>& entries){
 std::string out="{\"kind\":\"parameter_entries\",\"entries\":[";bool first=true;
 for(const auto& entry:entries){if(!first)out+=',';first=false;
  out+="{\"key\":"+q(entry.value.key)+",\"enum_key\":"+(entry.enum_key?"true":"false")+",\"value_json\":"+q(cell_artifact(entry.value))+",\"table_json\":"+(entry.table?q(serialize_embedding_workbench_table_json(*entry.table)):"null")+'}';
 }return out+"]}";
}
inline std::string arm(const EventAttribute&){return "raw_attribute";}
inline std::string arm(const std::vector<PandasVariantsFilterParameter>&){return "ordered_parameter_entries";}
inline std::optional<EventTable> auxiliary(const EventAttribute&){return std::nullopt;}
inline std::optional<EventTable> auxiliary(const std::vector<PandasVariantsFilterParameter>& entries){
 std::optional<EventTable> out;for(const auto& entry:entries)if(entry.table){require(!out,"unexpected second auxiliary table");out=*entry.table;}return out;
}
template<class Criterion,class Parameters>
inline std::string controls(const Criterion& criterion,const Parameters& parameters,const std::string& state,bool keyword_present){
 const auto actual_parameter=parameter(parameters);
 return "{\"args\":["+operand(criterion)+"],\"keyword_entries\":["+(keyword_present?"{\"key\":\"parameters\",\"value\":"+actual_parameter+'}':"")+"],\"parameter_state\":"+q(state)+",\"parameter_native_arm\":"+q(arm(parameters))+",\"parameters\":"+actual_parameter+",\"native_options_present\":false}";
}
inline void count_is(const Fields& f,const std::string& key,const EventTable& table,const std::string& context){
 const auto counts=Reader(raw(f,key)).fields();require(counts.size()==2&&raw(counts,"rows")==std::to_string(table.rows.size())&&raw(counts,"columns")==std::to_string(table.columns.size()),context+" table summary "+key);
}
inline void reopen(const std::string& artifact,const std::string& context){
 exact(serialize_embedding_workbench_table_json(parse_embedding_workbench_table_json(artifact)),artifact,context+" full native artifact reopen");
}
using Sender=std::function<DiscoveryWorkbenchResponse(const std::vector<DiscoveryWorkbenchPart>&)>;
inline void check(const Sender& send,const std::string& context,const std::string& operation,const std::string& call,
 const EventTable& source,const EventTable& source_after,const std::optional<EventTable>& result,
 const std::optional<EventTable>& variants,const std::string& controls_expected,const std::string& error_type,const std::string& error){
 const auto before_json=serialize_embedding_workbench_table_json(source),after_json=serialize_embedding_workbench_table_json(source_after);
 const auto variants_json=variants?std::optional<std::string>{serialize_embedding_workbench_table_json(*variants)}:std::nullopt;
 reopen(before_json,context+" source import");reopen(after_json,context+" source after");if(variants_json)reopen(*variants_json,context+" auxiliary import");
 std::vector<DiscoveryWorkbenchPart> parts={{"engine","","pandas",false},{"operation","",operation,false},{"call_json","call_json.txt",call,true},{"source_file","misleading.csv",before_json,true}};
 if(variants_json)parts.push_back({"variants_file","misleading.csv",*variants_json,true});
 const auto original=parts;const auto answer=send(parts);
 require(parts.size()==original.size(),context+" request part count changed");
 for(std::size_t i=0;i<parts.size();++i)require(parts[i].name==original[i].name&&parts[i].filename==original[i].filename&&parts[i].bytes==original[i].bytes&&parts[i].file==original[i].file,context+" request bytes changed");
 exact(serialize_embedding_workbench_table_json(source),before_json,context+" caller source changed");
 if(variants)exact(serialize_embedding_workbench_table_json(*variants),*variants_json,context+" caller auxiliary changed");
 const auto f=Reader(answer.json).fields();const std::vector<std::string> keys={"family","engine","operation","http_status","phase","apply_returned","source","result","source_unchanged","case_id_key","attribute_key","timestamp_key","source_table_json","filtered_table_json","variants_table_json","variants_source_unchanged","error_type","error","call_mode","call_json","controls_before_json","controls_after_json","controls_unchanged","source_after_table_json"};
 require(f.size()==24,context+" fixed24 fields differ");for(const auto& key:keys)(void)raw(f,key);
 require(answer.status==(result?200:400)&&raw(f,"http_status")==std::to_string(answer.status),context+" status differs");
 text_is(f,"family","TABLE_VARIANTS_FILTER",context);text_is(f,"engine","pandas",context);text_is(f,"operation",operation,context);
 text_is(f,"call_mode","original",context);text_is(f,"call_json",call,context);text_is(f,"phase",result?"complete":"apply",context);
 require(raw(f,"apply_returned")== (result?"true":"false"),context+" apply_returned differs");
 for(const auto& key:{"case_id_key","attribute_key","timestamp_key"})require(raw(f,key)=="null",context+" fabricated friendly selector "+key);
 text_is(f,"source_table_json",before_json,context);text_is(f,"source_after_table_json",after_json,context);count_is(f,"source",source,context);
 require(raw(f,"source_unchanged")== (before_json==after_json?"true":"false"),context+" source flag differs");
 reopen(*string(f,"source_after_table_json"),context+" returned source after");
 text_is(f,"controls_before_json",controls_expected,context);text_is(f,"controls_after_json",controls_expected,context);require(raw(f,"controls_unchanged")=="true",context+" actual control mutation differs");
 optional_is(f,"variants_table_json",variants_json,context);
 require(raw(f,"variants_source_unchanged")== (variants_json?"true":"null"),context+" auxiliary flag differs");
 if(variants_json)reopen(*string(f,"variants_table_json"),context+" returned actual auxiliary");
 if(!result){require(raw(f,"result")=="null"&&raw(f,"filtered_table_json")=="null",context+" diagnostic fabricated a result");text_is(f,"error_type",error_type,context);text_is(f,"error",error,context);return;}
 require(raw(f,"error_type")=="null"&&raw(f,"error")=="null",context+" unexpected diagnostic");count_is(f,"result",*result,context);
 const auto expected=serialize_embedding_workbench_table_json(*result);text_is(f,"filtered_table_json",expected,context);reopen(*string(f,"filtered_table_json"),context+" full result");
}
