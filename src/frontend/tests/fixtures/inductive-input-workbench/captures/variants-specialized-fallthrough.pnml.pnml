      <arc id="a2" source="p4" target="t1"/>
      <arc id="a3" source="t1" target="p6"/>
      <arc id="a4" source="p6" target="t2"/>
      <arc id="a5" source="t2" target="p5"/>
      <arc id="a6" source="p5" target="t3"/>
      <arc id="a7" source="t3" target="p6"/>
      <arc id="a8" source="p0" target="t4"/>
