<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>Original decision model</text></name>
    <page id="page1">
      <place id="p0">
        <name><text>p0</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <place id="p1">
        <name><text>p1</text></name>
      </place>
      <place id="choice">
        <name><text>choice</text></name>
      </place>
      <place id="p3">
        <name><text>p3</text></name>
      </place>
      <transition id="owned-transition-0">
        <name><text>A</text></name>
      </transition>
      <transition id="owned-transition-1">
        <name><text>D</text></name>
      </transition>
      <transition id="owned-transition-2">
        <name><text>B</text></name>
      </transition>
      <transition id="owned-transition-3">
        <name><text>C</text></name>
      </transition>
      <arc id="a0" source="p0" target="owned-transition-0"/>
      <arc id="a1" source="owned-transition-0" target="p1"/>
      <arc id="a2" source="p1" target="owned-transition-1"/>
      <arc id="a3" source="owned-transition-1" target="choice"/>
      <arc id="a4" source="choice" target="owned-transition-2"/>
      <arc id="a5" source="owned-transition-2" target="p3"/>
      <arc id="a6" source="choice" target="owned-transition-3"/>
      <arc id="a7" source="owned-transition-3" target="p3"/>
    </page>
    <finalmarkings>
      <marking>
        <place idref="p3"><text>1</text></place>
      </marking>
    </finalmarkings>
  </net>
</pnml>
