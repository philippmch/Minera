<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>Independent original PNML model</text></name>
    <page id="page1">
      <place id="s">
        <name><text>s</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <place id="f">
        <name><text>f</text></name>
      </place>
      <place id="reset-p">
        <name><text>reset-p</text></name>
        <initialMarking><text>2</text></initialMarking>
      </place>
      <place id="inhibitor-p">
        <name><text>inhibitor-p</text></name>
      </place>
      <transition id="foreign-transition-0">
        <name><text>A</text></name>
      </transition>
      <arc id="i" source="s" target="foreign-transition-0"/>
      <arc id="o" source="foreign-transition-0" target="f"/>
      <arc id="reset-original" source="reset-p" target="foreign-transition-0"><arctype><text>reset</text></arctype></arc>
      <arc id="inhibitor-original" source="inhibitor-p" target="foreign-transition-0"><arctype><text>inhibitor</text></arctype></arc>
    </page>
    <finalmarkings>
      <marking>
        <place idref="f"><text>1</text></place>
      </marking>
    </finalmarkings>
  </net>
</pnml>
