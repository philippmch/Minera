<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://minera.dev/bpmn" id="definitions">
  <process id="process" name="Independent process-tree alignment model" isExecutable="false">
    <startEvent id="StartEvent_0" name="start">
      <outgoing>Flow_5</outgoing>
    </startEvent>
    <exclusiveGateway id="exclusiveGateway_1" gatewayDirection="Converging">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_3</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="exclusiveGateway_2" gatewayDirection="Diverging">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_6</outgoing>
    </exclusiveGateway>
    <endEvent id="EndEvent_4" name="end">
      <incoming>Flow_6</incoming>
    </endEvent>
    <sequenceFlow id="Flow_3" sourceRef="exclusiveGateway_1" targetRef="exclusiveGateway_2"/>
    <sequenceFlow id="Flow_5" sourceRef="StartEvent_0" targetRef="exclusiveGateway_1"/>
    <sequenceFlow id="Flow_6" sourceRef="exclusiveGateway_2" targetRef="EndEvent_4"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_process">
    <bpmndi:BPMNPlane id="BPMNPlane_process" bpmnElement="process">
      <bpmndi:BPMNShape id="StartEvent_0_di" bpmnElement="StartEvent_0">
        <dc:Bounds x="82" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="exclusiveGateway_1_di" bpmnElement="exclusiveGateway_1">
        <dc:Bounds x="235" y="75" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="exclusiveGateway_2_di" bpmnElement="exclusiveGateway_2">
        <dc:Bounds x="395" y="75" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_4_di" bpmnElement="EndEvent_4">
        <dc:Bounds x="562" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="285" y="100"/>
        <di:waypoint x="395" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="118" y="100"/>
        <di:waypoint x="235" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="445" y="100"/>
        <di:waypoint x="562" y="100"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
