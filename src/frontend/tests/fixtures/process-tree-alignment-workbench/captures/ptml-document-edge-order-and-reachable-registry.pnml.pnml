<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>Independent process-tree alignment model</text></name>
    <page id="page1">
      <place id="source">
        <name><text>source</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <place id="sink">
        <name><text>sink</text></name>
      </place>
      <place id="p_3">
        <name><text>p_3</text></name>
      </place>
      <transition id="00000000-0000-4000-8000-000000000000">
        <name><text>B</text></name>
      </transition>
      <transition id="00000000-0000-4000-8000-000000000001">
        <name><text>A</text></name>
      </transition>
      <arc id="a0" source="source" target="00000000-0000-4000-8000-000000000000"/>
      <arc id="a1" source="00000000-0000-4000-8000-000000000000" target="p_3"/>
      <arc id="a2" source="p_3" target="00000000-0000-4000-8000-000000000001"/>
      <arc id="a3" source="00000000-0000-4000-8000-000000000001" target="sink"/>
    </page>
    <finalmarkings>
      <marking>
        <place idref="sink"><text>1</text></place>
      </marking>
    </finalmarkings>
  </net>
</pnml>
