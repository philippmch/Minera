<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>Independent process-tree alignment model</text></name>
    <page id="page1">
      <place id="source">
        <name><text>source</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <place id="sink">
        <name><text>sink</text></name>
      </place>
      <place id="p_5">
        <name><text>p_5</text></name>
      </place>
      <place id="p_6">
        <name><text>p_6</text></name>
      </place>
      <place id="p_7">
        <name><text>p_7</text></name>
      </place>
      <place id="p_8">
        <name><text>p_8</text></name>
      </place>
      <transition id="tau_1">
        <name><text>tau</text></name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="tau_1"/>
      </transition>
      <transition id="tauJoin_4">
        <name><text>tau</text></name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="tauJoin_4"/>
      </transition>
      <transition id="00000000-0000-4000-8000-000000000000">
        <name><text>A</text></name>
      </transition>
      <transition id="00000000-0000-4000-8000-000000000001">
        <name><text>B</text></name>
      </transition>
      <arc id="a0" source="source" target="tau_1"/>
      <arc id="a1" source="tau_1" target="p_5"/>
      <arc id="a2" source="tau_1" target="p_7"/>
      <arc id="a3" source="p_6" target="tauJoin_4"/>
      <arc id="a4" source="p_8" target="tauJoin_4"/>
      <arc id="a5" source="tauJoin_4" target="sink"/>
      <arc id="a6" source="p_5" target="00000000-0000-4000-8000-000000000000"/>
      <arc id="a7" source="00000000-0000-4000-8000-000000000000" target="p_6"/>
      <arc id="a8" source="p_7" target="00000000-0000-4000-8000-000000000001"/>
      <arc id="a9" source="00000000-0000-4000-8000-000000000001" target="p_8"/>
    </page>
    <finalmarkings>
