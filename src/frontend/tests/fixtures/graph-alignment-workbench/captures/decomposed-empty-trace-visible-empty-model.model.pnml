<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>Independent decomposed alignment model</text></name>
    <page id="page1">
      <place id="source 東京">
        <name><text>source 東京</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <place id="place,1">
        <name><text>place,1</text></name>
        <initialMarking><text>0</text></initialMarking>
      </place>
      <transition id="">
        <name><text></text></name>
      </transition>
      <arc id="arc,0,True" source="source 東京" target=""/>
      <arc id="arc,0,False" source="" target="place,1"/>
    </page>
    <finalmarkings>
      <marking>
        <place idref="source 東京"><text>0</text></place>
        <place idref="place,1"><text>1</text></place>
      </marking>
    </finalmarkings>
  </net>
</pnml>
