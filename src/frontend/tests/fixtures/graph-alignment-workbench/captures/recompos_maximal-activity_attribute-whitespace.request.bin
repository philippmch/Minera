Content-Disposition: form-data; name="input_file"; filename="owned-perfect-words.json"
Content-Type: application/octet-stream

["A","B"]

--OwnedGraphAlignmentFeature52
Content-Disposition: form-data; name="model_file"; filename="owned-normative.pnml"
Content-Type: application/octet-stream

<?xml version='1.0' encoding='utf-8'?>
<pnml>
  <net id="owned-net" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <page id="owned-page">
      <place id="source 東京">
        <initialMarking>
          <text>1</text>
        </initialMarking>
      </place>
      <place id="place,1">
        <initialMarking>
          <text>0</text>
        </initialMarking>
      </place>
      <place id="place,2" />
      <transition id="transition,0">
        <name>
          <text>A</text>
        </name>
      </transition>
      <arc id="arc,0,True" source="source 東京" target="transition,0" />
      <arc id="arc,0,False" source="transition,0" target="place,1" />
      <transition id="transition,1">
        <name>
          <text>B</text>
        </name>
      </transition>
      <arc id="arc,1,True" source="place,1" target="transition,1" />
      <arc id="arc,1,False" source="transition,1" target="place,2" />
    </page>
    <finalmarkings>
      <marking>
        <place idref="place,2">
          <text>1</text>
        </place>
        <place idref="source 東京">
          <text>0</text>
        </place>
      </marking>
    </finalmarkings>
  </net>
</pnml>
--OwnedGraphAlignmentFeature52--
