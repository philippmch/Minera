<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>Reduced original PNML model</text></name>
    <page id="page1">
      <place id="original-place-0">
        <name><text>original-place-0</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <place id="original-place-1">
        <name><text>original-place-1</text></name>
      </place>
      <place id="original-place-2">
        <name><text>original-place-2</text></name>
      </place>
      <transition id="t0">
        <name><text>A</text></name>
      </transition>
      <transition id="t1">
        <name><text>B</text></name>
      </transition>
      <arc id="a0" source="original-place-0" target="t0"/>
      <arc id="a1" source="t0" target="original-place-1"/>
      <arc id="a2" source="original-place-1" target="t1"/>
      <arc id="a3" source="t1" target="original-place-2"/>
    </page>
    <finalmarkings>
      <marking>
        <place idref="original-place-2"><text>1</text></place>
      </marking>
    </finalmarkings>
  </net>
</pnml>
