<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>Reduced original PNML model</text></name>
    <page id="page1">
      <place id="source">
        <name><text>source</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <place id="left">
        <name><text>left</text></name>
      </place>
      <place id="right">
        <name><text>right</text></name>
      </place>
      <place id="sink">
        <name><text>sink</text></name>
      </place>
      <transition id="t0">
        <name><text>a</text></name>
      </transition>
      <transition id="t1">
        <name><text>b</text></name>
      </transition>
      <transition id="t2">
        <name><text>c</text></name>
      </transition>
      <transition id="t3">
        <name><text>d</text></name>
      </transition>
      <arc id="a0" source="source" target="t0"/>
      <arc id="a1" source="t0" target="left"/>
      <arc id="a2" source="t0" target="right"/>
      <arc id="a3" source="source" target="t1"/>
      <arc id="a4" source="t1" target="left"/>
      <arc id="a5" source="t1" target="right"/>
      <arc id="a6" source="left" target="t2"/>
      <arc id="a7" source="t2" target="sink"/>
      <arc id="a8" source="right" target="t3"/>
      <arc id="a9" source="t3" target="sink"/>
    </page>
    <finalmarkings>
      <marking>
        <place idref="sink"><text>1</text></place>
      </marking>
    </finalmarkings>
  </net>
</pnml>
