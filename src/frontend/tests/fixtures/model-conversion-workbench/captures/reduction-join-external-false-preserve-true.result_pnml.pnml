<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>Reduced original PNML model</text></name>
    <page id="page1">
      <place id="p0">
        <name><text>p0</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <place id="p1">
        <name><text>p1</text></name>
      </place>
      <place id="p2">
        <name><text>p2</text></name>
      </place>
      <transition id="t0">
        <name><text>a</text></name>
      </transition>
      <transition id="t1">
        <name><text>b</text></name>
      </transition>
      <transition id="t2">
        <name><text>c</text></name>
      </transition>
      <transition id="t3">
        <name><text>d</text></name>
      </transition>
      <arc id="a0" source="p0" target="t0"/>
      <arc id="a1" source="t0" target="p1"/>
      <arc id="a2" source="p0" target="t1"/>
      <arc id="a3" source="t1" target="p1"/>
      <arc id="a4" source="p1" target="t2"/>
      <arc id="a5" source="t2" target="p2"/>
      <arc id="a6" source="p1" target="t3"/>
      <arc id="a7" source="t3" target="p2"/>
    </page>
    <finalmarkings>
      <marking>
        <place idref="p2"><text>1</text></place>
      </marking>
    </finalmarkings>
  </net>
</pnml>
