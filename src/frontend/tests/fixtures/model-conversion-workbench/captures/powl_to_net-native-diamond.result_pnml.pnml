<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>Converted POWL model</text></name>
    <page id="page1">
      <place id="p0">
        <name><text>p0</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <place id="p1">
        <name><text>p1</text></name>
      </place>
      <place id="p2">
        <name><text>p2</text></name>
      </place>
      <place id="p3">
        <name><text>p3</text></name>
      </place>
      <place id="p4">
        <name><text>p4</text></name>
      </place>
      <place id="p5">
        <name><text>p5</text></name>
      </place>
      <transition id="t0">
        <name><text>A</text></name>
      </transition>
      <transition id="t1">
        <name><text>B</text></name>
      </transition>
      <transition id="t2">
        <name><text>C</text></name>
      </transition>
      <transition id="t3">
        <name><text>D</text></name>
      </transition>
      <arc id="a0" source="p0" target="t0"/>
      <arc id="a1" source="t0" target="p2"/>
      <arc id="a2" source="t0" target="p3"/>
      <arc id="a3" source="p2" target="t1"/>
      <arc id="a4" source="t1" target="p4"/>
      <arc id="a5" source="p3" target="t2"/>
      <arc id="a6" source="t2" target="p5"/>
      <arc id="a7" source="p4" target="t3"/>
      <arc id="a8" source="p5" target="t3"/>
      <arc id="a9" source="t3" target="p1"/>
    </page>
    <finalmarkings>
      <marking>
        <place idref="p1"><text>1</text></place>
      </marking>
    </finalmarkings>
  </net>
</pnml>
