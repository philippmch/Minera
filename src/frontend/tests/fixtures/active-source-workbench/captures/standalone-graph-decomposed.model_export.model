<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>Independent decomposed alignment model</text></name>
    <page id="page1">
      <place id="p0">
        <name><text>p0</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <place id="p1">
        <name><text>p1</text></name>
      </place>
      <place id="p2">
        <name><text>p2</text></name>
      </place>
      <transition id="t0">
        <name><text>A</text></name>
      </transition>
      <transition id="t1">
        <name><text>B</text></name>
      </transition>
      <arc id="in-0" source="p0" target="t0"/>
      <arc id="out-0" source="t0" target="p1"/>
      <arc id="in-1" source="p1" target="t1"/>
      <arc id="out-1" source="t1" target="p2"/>
    </page>
    <finalmarkings>
      <marking>
        <place idref="p2"><text>1</text></place>
      </marking>
    </finalmarkings>
  </net>
</pnml>
