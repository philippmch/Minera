<?xml version='1.0' encoding='utf-8'?>
<pnml>
  <net id="original-monte-carlo-net" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <page id="original-page">
      <place id="owned-source">
        <name>
          <text>Original owned-source</text>
        </name>
        <initialMarking>
          <text>1</text>
        </initialMarking>
      </place>
      <place id="owned-sink">
        <name>
          <text>Original owned-sink</text>
        </name>
      </place>
      <transition id="owned-transition-0">
        <name>
          <text>A</text>
        </name>
      </transition>
      <arc id="owned-in" source="owned-source" target="owned-transition-0">
        <inscription>
          <text>1</text>
        </inscription>
      </arc>
      <arc id="owned-out" source="owned-transition-0" target="owned-sink">
        <inscription>
          <text>1</text>
        </inscription>
      </arc>
    </page>
    <finalmarkings>
      <marking>
        <place idref="owned-sink">
          <text>1</text>
        </place>
      </marking>
    </finalmarkings>
  </net>
</pnml>
--OwnedMonteCarloFeature58
