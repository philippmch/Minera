<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>Original Monte Carlo model</text></name>
    <page id="page1">
      <place id="source">
        <name><text>source</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <place id="sink">
        <name><text>sink</text></name>
      </place>
      <transition id="owned-transition-0">
        <name><text>A</text></name>
      </transition>
      <arc id="in" source="source" target="owned-transition-0"/>
      <arc id="loop" source="owned-transition-0" target="source"/>
      <arc id="out" source="owned-transition-0" target="sink"/>
    </page>
    <finalmarkings>
      <marking>
        <place idref="sink"><text>1</text></place>
      </marking>
    </finalmarkings>
  </net>
</pnml>
