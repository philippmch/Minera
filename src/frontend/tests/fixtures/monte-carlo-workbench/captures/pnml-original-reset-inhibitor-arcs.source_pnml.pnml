<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>Original Monte Carlo model</text></name>
    <page id="page1">
      <place id="source">
        <name><text>source</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <place id="sink">
        <name><text>sink</text></name>
      </place>
      <place id="reset-guard">
        <name><text>reset-guard</text></name>
      </place>
      <place id="inhibitor-guard">
        <name><text>inhibitor-guard</text></name>
      </place>
      <transition id="original-transition-0">
        <name><text>A</text></name>
      </transition>
      <arc id="in" source="source" target="original-transition-0"/>
      <arc id="out" source="original-transition-0" target="sink"/>
      <arc id="reset" source="reset-guard" target="original-transition-0"><arctype><text>reset</text></arctype></arc>
      <arc id="inhibitor" source="inhibitor-guard" target="original-transition-0"><arctype><text>inhibitor</text></arctype></arc>
    </page>
    <finalmarkings>
      <marking>
        <place idref="sink"><text>1</text></place>
      </marking>
    </finalmarkings>
  </net>
</pnml>
