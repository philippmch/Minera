<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>Independent Alpha+ discovery</text></name>
    <page id="page1">
      <place id="p0">
        <name><text>p0</text></name>
      </place>
      <place id="p1">
        <name><text>p1</text></name>
      </place>
      <place id="p2">
        <name><text>p2</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <transition id="t0">
        <name><text>tau</text></name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="t0"/>
      </transition>
      <transition id="t1">
        <name><text></text></name>
      </transition>
      <arc id="a0" source="p2" target="t0"/>
      <arc id="a1" source="t0" target="p1"/>
      <arc id="a2" source="p1" target="t1"/>
      <arc id="a3" source="t1" target="p0"/>
    </page>
    <finalmarkings>
      <marking>
        <place idref="p0"><text>1</text></place>
      </marking>
    </finalmarkings>
  </net>
</pnml>
