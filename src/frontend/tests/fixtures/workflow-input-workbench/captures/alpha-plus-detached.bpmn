<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://minera.dev/bpmn" id="definitions">
  <process id="process" name="Independent workflow discovery" isExecutable="false">
    <endEvent id="EndEvent_0" name="end">
      <incoming>Flow_3</incoming>
    </endEvent>
    <exclusiveGateway id="exclusiveGateway_1" gatewayDirection="Unspecified">
      <outgoing>Flow_3</outgoing>
    </exclusiveGateway>
    <task id="Activity_4" name="loop 東京">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_6</outgoing>
    </task>
    <sequenceFlow id="Flow_3" sourceRef="exclusiveGateway_1" targetRef="EndEvent_0"/>
    <sequenceFlow id="Flow_6" sourceRef="Activity_4" targetRef="Activity_4"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_process">
    <bpmndi:BPMNPlane id="BPMNPlane_process" bpmnElement="process">
      <bpmndi:BPMNShape id="EndEvent_0_di" bpmnElement="EndEvent_0">
        <dc:Bounds x="242" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="exclusiveGateway_1_di" bpmnElement="exclusiveGateway_1">
        <dc:Bounds x="75" y="75" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_4_di" bpmnElement="Activity_4">
        <dc:Bounds x="50" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="125" y="100"/>
        <di:waypoint x="242" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="150" y="220"/>
        <di:waypoint x="50" y="220"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
