  "native_checker_script": "import argparse,hashlib,json,subprocess\nfrom pathlib import Path\np=argparse.ArgumentParser();p.add_argument('--output',required=True);a=p.parse_args()\nref=json.loads(Path('build/heuristic-start-selector-reference.json').read_text(encoding='utf-8'));exe=Path('build/petri-comparison-checkpoint-build/Release/minera_export.exe');checks=[]\nfor i,r in enumerate(ref['observations']):\n x=Path(f'build/heuristic-selector-{i}.xes');x.write_text(r['xes'],encoding='utf-8');out=Path(f'build/heuristic-selector-{i}-native.json')\n cmd=[str(exe),str(x),'--heuristic-variant',r['variant'].lower(),'--heuristic-decoration','performance','-o',str(out)]\n if r['selector'] is not None:cmd+=['--heuristic-start-timestamp-attribute',r['selector']]\n if 'pm4py:param:timestamp_key' in r['parameters']:cmd+=['--heuristic-timestamp-attribute',r['parameters']['pm4py:param:timestamp_key']]\n proc=subprocess.run(cmd,capture_output=True,text=True,timeout=30)\n actual=None\n if proc.returncode==0:\n  net=json.loads(out.read_text(encoding='utf-8'))['heuristics_net'];names=net['activities'];actual=sorted([[ [names[e['source']],names[e['target']]],e['mean_wait_seconds']] for e in net['relation_statistics'] if e['direct_adjacency_frequency']])\n matched=(proc.returncode==1 and 'start timestamp' in proc.stderr and str(r['selector']) in proc.stderr) if 'error' in r else proc.returncode==0 and actual==r['performance_dfg']\n checks.append(dict(index=i,variant=r['variant'],selector=r['selector'],expected=r.get('performance_dfg',{'error':r.get('error')}),actual=actual,exit_code=proc.returncode,stderr=proc.stderr,matched=matched))\nreport=dict(checks=checks,native_executable_sha256=hashlib.sha256(exe.read_bytes()).hexdigest());Path(a.output).write_text(json.dumps(report,indent=2),encoding='utf-8');print(sum(c['matched'] for c in checks),'/',len(checks));print([(c['index'],c['expected'],c['actual']) for c in checks if not c['matched']])\n",
